# Berry Mist — Apache / Hostinger configuration

# Serve the Berry Mist app first even if WordPress files (index.php) exist in
# the same folder — the app takes over the (sub)domain it is uploaded to.
DirectoryIndex index.html index.php

RewriteEngine On

# Force HTTPS: login hashing uses the browser WebCrypto API, which is only
# available on secure origins — and visitors should never send passwords or
# read content over plain HTTP anyway. (Hostinger provides free SSL.)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical host: send www.berrymist.online to the bare berrymist.online so
# every visitor lands on ONE origin. Accounts, bookmarks, and the reading
# history live in per-origin browser storage — splitting visitors between www
# and the bare domain would give them two separate "sites".
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# The rotating database snapshots are private: they are byte-for-byte copies
# of the whole database, so serving one over HTTP would hand out everything
# the site stores. Denied first, before any other rule can rewrite the path.
RewriteRule ^api/backups(/.*)?$ - [F,L]

# Route the shared-database API to the PHP handler so the site works without a
# running Node.js server. The client keeps calling /api/db.
RewriteRule ^api/db/?$ api/db.php [L]

# Member account API (register / login / profile) -> PHP handler.
RewriteRule ^api/auth/?$ api/auth.php [L]

# Atomic view-count increment -> PHP handler.
RewriteRule ^api/view/?$ api/view.php [L]

# Sitemap: /sitemap.xml (the location crawlers check by default) is served by
# the live generator, so it always lists every novel AND chapter — a static
# file went stale the moment a chapter was published.
RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
RewriteRule ^api/sitemap\.php$ api/sitemap.php [L]

# RSS feed of the newest chapters, for readers and aggregators.
RewriteRule ^feed\.xml$ api/feed.php [L]
RewriteRule ^api/feed/?$ api/feed.php [L]

# Instant "this URL is new" push to search engines when a chapter is published.
RewriteRule ^api/indexnow/?$ api/indexnow.php [L]

# Novel and chapter pages are prerendered by PHP: the same index.html is served
# (so the app boots as usual) but with the real title/description/canonical and
# the chapter text already in the HTML. Without this, search engines would only
# ever see the empty single-page-app shell and a new chapter could take days to
# be indexed — or never rank at all.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^novel/.+$ api/page.php [L]

# Single-page app routing: every non-file path goes through api/page.php, which
# serves the app shell for the screens that EXIST and answers an honest 404
# (status + noindex) for everything else. Serving the shell with a 200 for
# unknown URLs was a site-wide "soft 404" quality problem for search engines.
# File-like paths (anything ending in a real extension) are EXCLUDED: a missing
# .html/.txt/.xml must return the server's plain 404 instead of the app shell —
# that is what makes Google report "the verification file contains incorrect
# content" instead of simply "not found".
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(html?|txt|xml|json|js|mjs|css|map|php|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot|pdf|zip)$ [NC]
RewriteRule ^ api/page.php [L]

# Never expose the shared data file, the member accounts file, or the
# runtime lock/temp files directly.
# One pattern covers the database, the accounts file, their .lock/.tmp.<pid>
# siblings AND the rotating snapshots (berry_db-YYYYMMDD-HH.json) — a
# name-only <Files> rule matched none of those, so a backup copy of the whole
# database, and the accounts file mid-write, were reachable over HTTP.
<FilesMatch "^berry_(db|users)[^/]*\.json.*$">
  Require all denied
</FilesMatch>

# Compress text responses before they go over the wire. The shared database,
# the sitemap and the feed are all text that compresses several times over,
# and every visitor downloads the database on their FIRST entry before a
# single chapter can be listed — uncompressed, that was a multi-second wait on
# mobile data with the page frame visible but no chapters in it.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caching.
# Only Vite's content-hashed build files (name-HASH.ext, e.g.
# index-Dn3DL7zQ.js) may be cached immutably for a year: their content never
# changes without the URL changing too. The named brand images at the site
# root (favicon, logo, og-image) keep the SAME filename when they are fixed
# or replaced, so a year-long cache would keep showing visitors — and the
# search crawler — the old file for months; they get one hour instead.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(favicon\.(ico|png)|apple-touch-icon\.png|og-image\.jpg|site_logo[^/]*\.(png|jpe?g)|site_banner\.png)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
