# BerryMist — Apache / Hostinger configuration

# Serve the BerryMist app first even if WordPress files (index.php) exist in
# the same folder — the app takes over the (sub)domain it is uploaded to.
DirectoryIndex index.html index.php

RewriteEngine On

# Force HTTPS: login hashing uses the browser WebCrypto API, which is only
# available on secure origins — and visitors should never send passwords or
# read content over plain HTTP anyway. (Hostinger provides free SSL.)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical host: send www.berrymist.com to the bare berrymist.com so every
# visitor lands on ONE origin. Accounts, bookmarks, and the reading history
# live in per-origin browser storage — splitting visitors between www and the
# bare domain would give them two separate "sites".
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Route the shared-database API to the PHP handler so the site works without a
# running Node.js server. The client keeps calling /api/db.
RewriteRule ^api/db/?$ api/db.php [L]

# Sitemap: /sitemap.xml (the location crawlers check by default) is served by
# the live generator, so it always lists every novel AND chapter — a static
# file went stale the moment a chapter was published.
RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
RewriteRule ^api/sitemap\.php$ api/sitemap.php [L]

# RSS feed of the newest chapters, for readers and aggregators.
RewriteRule ^feed\.xml$ api/feed.php [L]
RewriteRule ^api/feed/?$ api/feed.php [L]

# Instant "this URL is new" push to search engines when a chapter is published.
RewriteRule ^api/indexnow/?$ api/indexnow.php [L]

# Novel and chapter pages are prerendered by PHP: the same index.html is served
# (so the app boots as usual) but with the real title/description/canonical and
# the chapter text already in the HTML. Without this, search engines would only
# ever see the empty single-page-app shell and a new chapter could take days to
# be indexed — or never rank at all.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^novel/.+$ api/page.php [L]

# Single-page app fallback: serve index.html for any other path that is not a
# real file or directory, so deep links and refreshes don't 404.
#
# File-like paths (anything ending in a real extension) are EXCLUDED: a missing
# .html/.txt/.xml must return an honest 404 instead of the app shell. Returning
# the shell made every missing file look like a valid page — that is what made
# Google report "the verification file contains incorrect content" instead of
# simply "not found", and search engines treat such soft-404s as a quality
# problem across the whole site.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(html?|txt|xml|json|js|mjs|css|map|php|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot|pdf|zip)$ [NC]
RewriteRule ^ index.html [L]

# Never expose the shared data file or the accounts file directly to the
# public — accounts (emails + password hashes) are read only by auth.php.
<Files "berry_db.json">
  Require all denied
</Files>
<Files "berry_users.json">
  Require all denied
</Files>

# Sensible caching for built assets (they are content-hashed by Vite).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html must always be re-fetched so visitors get the LATEST build
  # (which references the newest hashed JS/CSS) immediately after every deploy —
  # never a stale cached shell.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # The shared APIs are dynamic — never let a proxy/CDN cache their responses
  # (the app does its own ETag-based conditional polling).
  <FilesMatch "^(db|auth|sitemap)\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
